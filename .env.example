# Supabase Public Configuration Template
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Desarrollo local: `vite dev` ya omite el login de Google automáticamente,
# no hace falta tocar esto. Si alguna vez quieres probar el login real de
# Google en tu máquina, pon VITE_SKIP_AUTH=false aquí abajo.
# No tiene ningún efecto en producción (vite build lo ignora).
# VITE_SKIP_AUTH=false
